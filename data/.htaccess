# Prevent directory listing
Options -Indexes

# Apache 2.4+
<IfModule mod_authz_core.c>
    # By default, we might want to keep things restricted
    # But we specifically allow the JSON files needed by the frontend
    <FilesMatch "^(wall_preset\.json|updates\.json)$">
        Require all granted
    </FilesMatch>
    
    # We don't use 'Require all denied' here to allow subdirectories 
    # (like uploads/) to have their own .htaccess rules.
</IfModule>

# Apache 2.2 / Legacy
<IfModule !mod_authz_core.c>
    Order Deny,Allow
    Deny from all
    <FilesMatch "^(wall_preset\.json|updates\.json)$">
        Allow from all
    </FilesMatch>
</IfModule>
